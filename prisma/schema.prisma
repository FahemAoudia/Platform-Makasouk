// ATELIER — Prisma schema (PostgreSQL en prod / local avec DATABASE_URL Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  TAILOR
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  SHIPPED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(CLIENT)
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tailorProfile TailorProfile?
  carts         Cart[]
  orders        Order[]        @relation("ClientOrders")
  favorites     Favorite[]
  preferences   UserPreference?
  reviewsGiven  TailorReview[] @relation("ReviewAuthor")
}

model TailorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  active      Boolean  @default(true)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  createdAt   DateTime @default(now())

  categories     TailorCategory[]
  ordersAccepted Order[]        @relation("TailorOrders")
  reviews        TailorReview[]
}

/// Join: tailor ↔ many categories
model TailorCategory {
  tailorProfileId String
  categoryId      String

  tailorProfile TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tailorProfileId, categoryId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  heroImage   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  models      FashionModel[]
  tailorLinks TailorCategory[]
  orders      Order[]
}

model FashionModel {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  subtitle    String?
  description String
  images      Json
  videoUrl    String?
  basePrice   Float
  tags        Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]
}

model MeasurementField {
  id            String  @id @default(cuid())
  key           String  @unique
  label         String
  unit          String  @default("cm")
  sortOrder     Int     @default(0)
  guideImageUrl String?
  guideVideoUrl String?
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id           String       @id @default(cuid())
  cartId       String
  cart         Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  modelId      String
  model        FashionModel @relation(fields: [modelId], references: [id])
  measurements Json
  quantity     Int          @default(1)
  createdAt    DateTime     @default(now())

  @@unique([cartId, modelId])
}

model Order {
  id          String      @id @default(cuid())
  clientId    String
  client      User        @relation("ClientOrders", fields: [clientId], references: [id])
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  status      OrderStatus @default(PENDING)

  tailorId String?
  tailor   TailorProfile? @relation("TailorOrders", fields: [tailorId], references: [id])

  subtotal    Float
  currency    String   @default("USD")
  lockVersion Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  acceptedAt DateTime?
  cancelledAt DateTime?

  /// Soft-delete (admin-only); hidden from clients, tailors, and analytics.
  isDeleted Boolean @default(false)

  items  OrderItem[]
  review TailorReview?
}

model OrderItem {
  id      String       @id @default(cuid())
  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  modelId String
  model   FashionModel @relation(fields: [modelId], references: [id])

  measurements Json
  unitPrice    Float
  quantity     Int      @default(1)
}

model Favorite {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  modelId String
  model   FashionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, modelId])
}

model TailorReview {
  id      String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tailorId String
  tailor   TailorProfile @relation(fields: [tailorId], references: [id])

  authorId String
  author   User @relation("ReviewAuthor", fields: [authorId], references: [id])

  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model UserPreference {
  id     String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryWeights Json
  tagAffinity     Json

  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id String @id @default(cuid())

  actorId    String
  action     String
  entityType String
  entityId   String?
  meta       Json?

  createdAt DateTime @default(now())
}