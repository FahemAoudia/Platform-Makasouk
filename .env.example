# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelier?schema=public"

# API
PORT=4000
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:3000"

# Web (Next.js)
# Même base que NEXT_PUBLIC_API_URL — RSC / serveur (ne pas utiliser le nom API_URL sur Railway Railpack).
SERVER_API_BASE="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# Public base URL for uploaded files (same origin as API; paths are /uploads/...)
UPLOAD_PUBLIC_BASE="http://localhost:4000"

# Optional: Stripe
# STRIPE_SECRET_KEY=
